{
  "name": "remote-desktop-terminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server that drives a PowerShell session inside a Citrix/RDP window over the synced clipboard.",
  "bin": {
    "rdt-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "node --experimental-strip-types --no-warnings src/index.ts",
    "selftest": "node --experimental-strip-types --no-warnings scripts/selftest.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
